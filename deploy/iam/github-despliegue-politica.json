{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EjecutarElDespliegueEnLaBeta",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ec2:REGION:CUENTA:instance/ID_INSTANCIA",
        "arn:aws:ssm:REGION::document/AWS-RunShellScript"
      ]
    },
    {
      "Sid": "LeerElResultado",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations"
      ],
      "Resource": "*"
    }
  ]
}