# === Base de datos ===
POSTGRES_USER=comanda
POSTGRES_PASSWORD=comanda_dev_password
POSTGRES_DB=comanda
POSTGRES_PORT=5432
# Usada por Prisma dentro del contenedor backend (host = nombre del servicio compose)
DATABASE_URL="postgresql://comanda:comanda_dev_password@postgres:5432/comanda?schema=public"

# === Redis ===
REDIS_PORT=6379
REDIS_URL="redis://redis:6379"

# === Backend ===
BACKEND_PORT=3000
JWT_SECRET=cambia_este_secreto_en_produccion
JWT_EXPIRES_IN=8h
NODE_ENV=development

# === Frontend ===
FRONTEND_PORT=5173
# Fase 13B: el navegador llama a la API por rutas relativas del mismo origen.
# Por Nginx (https://localhost:8443) /api y /socket.io van a los backends; por
# Vite directo (http://localhost:5173) los reenvía el proxy de vite.config.ts.
VITE_API_URL=/api
# Vacío = mismo origen de la página (Socket.IO usa /socket.io).
VITE_WS_URL=
# URL base que se codifica en los QR de las mesas (CU-03). Si se deja vacía se
# usa el origen del navegador. Para escanear con un teléfono real, poner la IP
# de la máquina en la red local (p. ej. https://192.168.1.10:8443) y la misma
# IP en NGINX_CERT_IP.
VITE_PUBLIC_URL=

# === Cola fiscal y DIAN simulada (Fase 11B) ===
# Intentos de la cola ante fallas técnicas del proveedor (backoff exponencial desde 2 s)
COLA_FISCAL_INTENTOS=5
# Simulador del proveedor DIAN: latencia por validación y probabilidades (0 a 1)
# de que "se caiga" (se reintenta) o de que rechace el documento (no se reintenta)
DIAN_SIMULADA_LATENCIA_MS=2000
DIAN_SIMULADA_TASA_FALLA=0.2
DIAN_SIMULADA_TASA_RECHAZO=0.1

# === Almacén de objetos: MinIO / S3 (Fase 11B) ===
MINIO_ROOT_USER=comanda
MINIO_ROOT_PASSWORD=comanda_minio_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Usadas por backend y worker (host = nombre del servicio compose)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=comanda-documentos
S3_ACCESS_KEY=comanda
S3_SECRET_KEY=comanda_minio_dev_password

# === Plataforma de domicilios simulada (Fase 12B, CU-05) ===
# Intentos de la cola de acuses a la plataforma (backoff exponencial desde 2 s)
COLA_PLATAFORMAS_INTENTOS=5
# API key de la integración demo que crea el seed (solo se guarda su hash).
# La página /simulador-plataforma la pide para mandar pedidos.
PLATAFORMA_SIMULADA_API_KEY=cambia_esta_api_key_de_plataforma
# Base del webhook de acuses del simulador, vista desde el contenedor worker
PLATAFORMA_SIMULADA_URL_ACUSES_BASE=http://backend:3000

# === Proxy inverso Nginx (Fase 13B) ===
# Entrada única de la app: https://localhost:${NGINX_HTTPS_PORT}
NGINX_HTTPS_PORT=8443
# IP de la máquina en la red local para incluirla en el certificado
# autofirmado (opcional; vacío = solo localhost)
NGINX_CERT_IP=
