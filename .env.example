# === Base de datos ===
POSTGRES_USER=comanda
POSTGRES_PASSWORD=comanda_dev_password
POSTGRES_DB=comanda
POSTGRES_PORT=5432
# Usada por Prisma dentro del contenedor backend (host = nombre del servicio compose)
DATABASE_URL="postgresql://comanda:comanda_dev_password@postgres:5432/comanda?schema=public"

# === Redis ===
REDIS_PORT=6379
REDIS_URL="redis://redis:6379"

# === Backend ===
BACKEND_PORT=3000
JWT_SECRET=cambia_este_secreto_en_produccion
JWT_EXPIRES_IN=8h
NODE_ENV=development

# === Frontend ===
FRONTEND_PORT=5173
# URL desde la que el navegador del cliente llama al backend (fuera de la red docker)
VITE_API_URL=http://localhost:3000
VITE_WS_URL=http://localhost:3000
# URL base que se codifica en los QR de las mesas (CU-03). Si se deja vacía se
# usa el origen del navegador (localhost). Para escanear con un teléfono real,
# poner la IP de la máquina en la red local (p. ej. http://192.168.1.10:5173)
# y apuntar también VITE_API_URL a esa IP.
VITE_PUBLIC_URL=
