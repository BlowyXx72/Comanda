# Fase 17B: Nginx de producción (beta en EC2). A diferencia del de desarrollo
# (nginx/Dockerfile, que reenvía / al servidor de Vite), este sirve el
# frontend ya compilado (`vite build`) y termina TLS con el certificado de
# Let's Encrypt (Fase 19B) o, mientras no exista, uno autofirmado.
# Se construye desde la raíz del repo: docker build -f nginx/Dockerfile.prod .

# 1) Compila el frontend a archivos estáticos.
FROM node:22-alpine AS frontend
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

# 2) Nginx con los estáticos y la configuración de producción.
# 1.27.3+ por `resolve` en los upstream (igual que el de desarrollo).
FROM nginx:1.27-alpine
RUN apk add --no-cache openssl
# La imagen oficial pasa los *.template de /etc/nginx/templates por envsubst
# (solo con las variables que existen en el entorno, p. ej. ${DOMINIO}) y deja
# el resultado en /etc/nginx/conf.d/ antes de arrancar.
COPY nginx/comanda.prod.conf.template /etc/nginx/templates/comanda.conf.template
COPY nginx/certificado-prod.sh /docker-entrypoint.d/05-certificado-prod.sh
RUN sed -i 's/\r$//' /docker-entrypoint.d/05-certificado-prod.sh \
  && chmod +x /docker-entrypoint.d/05-certificado-prod.sh \
  && rm /etc/nginx/conf.d/default.conf \
  && mkdir -p /var/www/certbot
COPY --from=frontend /app/dist /usr/share/nginx/html
