# Fase 17B: variables del ambiente beta (EC2 con docker-compose.prod.yml).
# Copiar a .env.prod (no va a git) y cambiar TODOS los valores "cambia_...".
# En la Fase 19B este archivo se arma en la EC2 a partir de SSM Parameter
# Store, para que los secretos no vivan en un archivo copiado a mano.
# Generar secretos: openssl rand -base64 32

# === Dominio ===
# Nombre por el que se entra a la app; con él se pide el certificado de
# Let's Encrypt (Fase 19B). Mientras no exista, Nginx usa uno provisional.
DOMINIO=comanda.ejemplo.co
CORS_ORIGENES=https://comanda.ejemplo.co
# Fase 20B: subdominio por cadena (lacadena.comanda.ejemplo.co). Necesita el
# registro DNS comodín *.comanda.ejemplo.co y el certificado comodín
# (deploy/certificado.sh comodin). Vacío = sin subdominios.
URL_PUBLICA_CADENA=https://{subdominio}.comanda.ejemplo.co
SWAGGER_HABILITADO=false
LOG_FORMATO=json
NODE_ENV=production

# === Imágenes (Fase 18B) ===
# Registro y etiqueta de las imágenes que se descargan con `docker compose pull`.
# El dueño del repo en minúsculas (GHCR no acepta mayúsculas).
REGISTRO=ghcr.io/blowyxx72
TAG=latest

# === Base de datos ===
POSTGRES_USER=comanda
POSTGRES_PASSWORD=cambia_esta_clave_postgres
POSTGRES_DB=comanda
DATABASE_URL="postgresql://comanda:cambia_esta_clave_postgres@postgres:5432/comanda?schema=public"
DATABASE_URL_APP="postgresql://comanda_app:cambia_esta_clave_app@postgres:5432/comanda?schema=public"
POSTGRES_REPLICATION_USER=replicador
POSTGRES_REPLICATION_PASSWORD=cambia_esta_clave_replica
DATABASE_URL_REPLICA="postgresql://comanda_app:cambia_esta_clave_app@postgres-replica:5432/comanda?schema=public"

# === Backend ===
JWT_SECRET=cambia_este_secreto_jwt
JWT_EXPIRES_IN=8h

# === Colas y DIAN simulada (sigue siendo un simulador: la DIAN real está prohibida) ===
COLA_FISCAL_INTENTOS=5
DIAN_SIMULADA_LATENCIA_MS=2000
DIAN_SIMULADA_TASA_FALLA=0.2
DIAN_SIMULADA_TASA_RECHAZO=0.1
COLA_PLATAFORMAS_INTENTOS=5
COLA_CORREO_INTENTOS=5
RESUMEN_DIARIO_CRON="0 23 * * *"
RESUMEN_DIARIO_ZONA=America/Bogota

# === Plataforma simulada (Rappi real está prohibido) ===
PLATAFORMA_SIMULADA_API_KEY=cambia_esta_api_key_de_plataforma
PLATAFORMA_SIMULADA_URL_ACUSES_BASE=http://backend:3000

# === Región de AWS (Fase 21B: logs de Docker a CloudWatch) ===
AWS_REGION=us-east-1

# === Amazon S3 ===
# Sin S3_ENDPOINT ni S3_ACCESS_KEY: el SDK usa Amazon S3 de la región con el
# rol de IAM de la EC2 (Fase 19B). Los nombres de bucket son globales en AWS.
S3_REGION=us-east-1
S3_BUCKET=comanda-documentos-cambia-sufijo
S3_BUCKET_IMAGENES=comanda-imagenes-cambia-sufijo
S3_FORCE_PATH_STYLE=false
# Vacío = el backend sirve las fotos (con caché en Nginx). Con CloudFront:
# su URL, p. ej. https://d1234abcd.cloudfront.net
URL_PUBLICA_IMAGENES=

# === Amazon SES (SMTP) ===
# Credenciales SMTP de SES (no son las llaves de IAM). En sandbox solo envía
# a direcciones verificadas.
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=cambia_usuario_smtp_ses
SMTP_PASS=cambia_clave_smtp_ses
SMTP_FROM="Comanda Central <no-responder@comanda.ejemplo.co>"
