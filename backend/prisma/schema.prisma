// Subconjunto de entidades del ER de la propuesta necesario para el
// vertical slice de este prototipo. Ver docs/prototipo-slice.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RolUsuario {
  ADMIN
  CAJERO
  MESERO
}

enum EstadoMesa {
  LIBRE
  OCUPADA
}

enum CanalPedido {
  SALON
  DOMICILIO
  // Fase 12B (CU-05): pedido que entra por API desde una plataforma de
  // domicilios externa. En este prototipo la plataforma es un simulador.
  PLATAFORMA
  // TODO PRODUCCION: QR cuando el comensal pueda pedir desde la mesa
}

enum EstadoPedido {
  ABIERTO
  EN_PREPARACION
  LISTO
  PAGADO
}

enum MedioPago {
  EFECTIVO
  TARJETA
}

enum TipoDocumentoFiscal {
  FACTURA
}

enum EstadoDian {
  // Documentos cobrados antes de la Fase 11B: nunca pasaron por la cola.
  SIMULADO
  // Fase 11B: el cobro deja el documento PENDIENTE y el worker lo "valida"
  // en segundo plano contra ProveedorDianSimulado (§5.1, §6.3).
  PENDIENTE
  VALIDADO_SIMULADO
  RECHAZADO_SIMULADO
  // TODO PRODUCCION: estados reales del proveedor tecnológico DIAN
}

// Fase 11 (§6.2): tipo de movimiento de inventario. SALIDA solo la crea
// PaymentsService.pagar (descuento automático por receta); ENTRADA y MERMA
// se registran a mano desde POST /inventario/movimientos.
enum TipoMovimientoInventario {
  ENTRADA
  SALIDA
  MERMA
}

// Tenant
model Cadena {
  id       String   @id @default(uuid())
  nit      String   @unique
  nombre   String
  plan     String
  creadoEn DateTime @default(now()) @map("creado_en")

  sedes     Sede[]
  usuarios  Usuario[]
  productos Producto[]
  clientes  Cliente[]
  insumos   Insumo[]

  integracionesPlataforma IntegracionPlataforma[]

  @@map("cadenas")
}

model Sede {
  id        String @id @default(uuid())
  cadenaId  String @map("cadena_id")
  nombre    String
  direccion String

  // Rango de numeración fiscal pre-asignado a la sede (§6.3 de la propuesta):
  // cada sede tiene su propio [rangoInicio, rangoFin] para que dos sedes (o
  // una sede sin conexión) nunca generen el mismo consecutivo. Reemplaza el
  // campo de texto `rangoNumeracion` de la Fase 0-6, que existía pero no se
  // usaba de verdad (ver docs/prototipo-slice.md).
  rangoInicio          Int @map("rango_inicio")
  rangoFin             Int @map("rango_fin")
  // Próximo consecutivo a asignar; avanza atómicamente (UPDATE ... increment)
  // dentro de la transacción de PaymentsService.pagar, sin condición de
  // carrera entre cajas concurrentes de la misma sede.
  siguienteConsecutivo Int @map("siguiente_consecutivo")

  cadena                 Cadena                  @relation(fields: [cadenaId], references: [id])
  mesas                  Mesa[]
  pedidos                Pedido[]
  documentosFiscales     DocumentoFiscal[]
  movimientosInventario  MovimientoInventario[]

  @@map("sedes")
}

model Usuario {
  id           String     @id @default(uuid())
  cadenaId     String     @map("cadena_id")
  rol          RolUsuario
  email        String     @unique
  passwordHash String     @map("password_hash")

  cadena  Cadena   @relation(fields: [cadenaId], references: [id])
  pedidos Pedido[]

  @@map("usuarios")
}

model Producto {
  id        String  @id @default(uuid())
  cadenaId  String  @map("cadena_id")
  nombre    String
  precio    Decimal @db.Decimal(10, 2)
  categoria String
  // Fase 10 (CU-08): baja lógica desde el catálogo centralizado. Un producto
  // desactivado no aparece en GET /productos (mesero) pero sigue existiendo
  // para los PedidoDetalle históricos que ya lo referencian.
  activo    Boolean @default(true)

  cadena   Cadena          @relation(fields: [cadenaId], references: [id])
  detalles PedidoDetalle[]
  receta   Receta[]

  @@map("productos")
}

model Mesa {
  id     String     @id @default(uuid())
  sedeId String     @map("sede_id")
  numero Int
  estado EstadoMesa @default(LIBRE)

  sede    Sede     @relation(fields: [sedeId], references: [id])
  pedidos Pedido[]

  @@unique([sedeId, numero])
  @@map("mesas")
}

model Pedido {
  // DECISIÓN DE PROTOTIPO: el UUID lo genera el cliente y viaja en la petición
  // (POST /pedidos); el default de acá es solo un respaldo si algún día se crea
  // un pedido desde el propio backend sin UUID explícito.
  id                String       @id @default(uuid())
  sedeId            String       @map("sede_id")
  mesaId            String?      @map("mesa_id")
  // Opcional desde Fase 8B: un pedido de domicilio lo crea el cliente desde
  // la web, no un usuario interno; en ese caso va clienteId.
  usuarioId         String?      @map("usuario_id")
  clienteId         String?      @map("cliente_id")
  // Fase 12B: solo en pedidos de canal PLATAFORMA. La referencia es el id del
  // pedido en la plataforma; única por integración, para que un reenvío de la
  // plataforma no duplique la comanda.
  integracionId     String?      @map("integracion_id")
  referenciaExterna String?      @map("referencia_externa")
  canal             CanalPedido  @default(SALON)
  estado            EstadoPedido @default(ABIERTO)
  fechaHora         DateTime     @default(now()) @map("fecha_hora")
  total             Decimal      @default(0) @db.Decimal(10, 2)

  sede            Sede                   @relation(fields: [sedeId], references: [id])
  mesa            Mesa?                  @relation(fields: [mesaId], references: [id])
  usuario         Usuario?               @relation(fields: [usuarioId], references: [id])
  cliente         Cliente?               @relation(fields: [clienteId], references: [id])
  integracion     IntegracionPlataforma? @relation(fields: [integracionId], references: [id])
  detalles        PedidoDetalle[]
  pagos           Pago[]
  documentoFiscal DocumentoFiscal?

  movimientosInventario MovimientoInventario[]

  @@unique([integracionId, referenciaExterna])
  @@map("pedidos")
}

// Fase 12B (CU-05): una plataforma de domicilios conectada a una cadena.
// La plataforma se autentica con una API key (header X-Api-Key); aquí solo se
// guarda su hash SHA-256, nunca la llave en claro.
// DECISIÓN DE PROTOTIPO: `urlAcuse` es el webhook al que el worker le avisa a
// la plataforma que el pedido entró a cocina. La propuesta pide que esa
// comunicación salga por el trabajador asíncrono (§5.1), no fija el formato.
model IntegracionPlataforma {
  id         String  @id @default(uuid())
  cadenaId   String  @map("cadena_id")
  nombre     String
  apiKeyHash String  @unique @map("api_key_hash")
  urlAcuse   String? @map("url_acuse")
  activa     Boolean @default(true)

  cadena  Cadena   @relation(fields: [cadenaId], references: [id])
  pedidos Pedido[]

  @@map("integraciones_plataforma")
}

// Entidad Cliente del ER de la propuesta (§6.2), usada por los pedidos de
// domicilio web (CU-04).
model Cliente {
  id        String @id @default(uuid())
  cadenaId  String @map("cadena_id")
  nombre    String
  telefono  String
  direccion String
  // Fase 14B (§5.2, SMTP): a dónde se envía el comprobante del domicilio.
  // DECISIÓN DE PROTOTIPO: el ER no tiene correo en Cliente; es opcional.
  email     String?

  cadena  Cadena   @relation(fields: [cadenaId], references: [id])
  pedidos Pedido[]

  @@map("clientes")
}

model PedidoDetalle {
  id             String  @id @default(uuid())
  pedidoId       String  @map("pedido_id")
  productoId     String  @map("producto_id")
  cantidad       Int
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(10, 2)
  notas          String?

  pedido   Pedido   @relation(fields: [pedidoId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  @@map("pedido_detalles")
}

model Pago {
  id       String    @id @default(uuid())
  pedidoId String    @map("pedido_id")
  medio    MedioPago
  monto    Decimal   @db.Decimal(10, 2)
  creadoEn DateTime  @default(now()) @map("creado_en")

  pedido Pedido @relation(fields: [pedidoId], references: [id])

  @@map("pagos")
}

model DocumentoFiscal {
  id       String @id @default(uuid())
  // @unique porque un pedido genera a lo sumo un documento fiscal (1:1, igual
  // que en el ER de la propuesta): antes esto era Pedido 1:N sin querer.
  pedidoId String @unique @map("pedido_id")
  // Denormalizado desde pedido.sedeId: el consecutivo es por sede, no por pedido,
  // así que necesitamos la sede aquí directamente para la restricción de unicidad.
  sedeId   String @map("sede_id")

  tipo        TipoDocumentoFiscal @default(FACTURA)
  consecutivo Int
  estadoDian  EstadoDian          @default(PENDIENTE) @map("estado_dian")
  // Fase 11B: URI del XML en el almacén de objetos (s3://bucket/llave);
  // el navegador lo descarga por GET /documentos-fiscales/:id/xml.
  urlXml      String?             @map("url_xml")
  // Respuesta (simulada) del proveedor DIAN o motivo del rechazo.
  mensajeDian String?             @map("mensaje_dian")
  validadoEn  DateTime?           @map("validado_en")
  creadoEn    DateTime            @default(now()) @map("creado_en")

  pedido Pedido @relation(fields: [pedidoId], references: [id])
  sede   Sede   @relation(fields: [sedeId], references: [id])

  @@unique([sedeId, consecutivo])
  @@map("documentos_fiscales")
}

// Fase 11 (§6.2): insumos de la cadena. Sirven de base para las recetas de
// los productos y para los movimientos de inventario por sede.
model Insumo {
  id            String  @id @default(uuid())
  cadenaId      String  @map("cadena_id")
  nombre        String
  unidad        String
  costoUnitario Decimal @map("costo_unitario") @db.Decimal(10, 2)

  cadena      Cadena                 @relation(fields: [cadenaId], references: [id])
  receta      Receta[]
  movimientos MovimientoInventario[]

  @@map("insumos")
}

// Cuánto de un insumo necesita una unidad de un producto. PK compuesta: un
// producto tiene a lo sumo una fila por insumo. PaymentsService.pagar la usa
// para calcular los MovimientoInventario de tipo SALIDA al cobrar.
model Receta {
  productoId String  @map("producto_id")
  insumoId   String  @map("insumo_id")
  cantidad   Decimal @db.Decimal(10, 2)

  producto Producto @relation(fields: [productoId], references: [id])
  insumo   Insumo   @relation(fields: [insumoId], references: [id])

  @@id([productoId, insumoId])
  @@map("recetas")
}

// Existencias de un insumo en una sede = suma de sus movimientos (no hay
// columna de stock, ver docs/fases-siguientes-2.md Fase 11). ENTRADA/MERMA
// se registran a mano (POST /inventario/movimientos); SALIDA la crea
// PaymentsService.pagar dentro de la transacción del cobro, una por cada
// insumo de la receta de cada detalle del pedido.
model MovimientoInventario {
  id       String                   @id @default(uuid())
  sedeId   String                   @map("sede_id")
  insumoId String                   @map("insumo_id")
  tipo     TipoMovimientoInventario
  cantidad Decimal                  @db.Decimal(10, 2)
  fecha    DateTime                 @default(now())
  // Ronda 3: pedido que originó una SALIDA (null en ENTRADA/MERMA manuales y
  // en las SALIDA anteriores a este cambio). Permite saber si un pedido ya
  // descontó su receta y no descontarla dos veces.
  pedidoId String?                  @map("pedido_id")

  sede   Sede    @relation(fields: [sedeId], references: [id])
  insumo Insumo  @relation(fields: [insumoId], references: [id])
  pedido Pedido? @relation(fields: [pedidoId], references: [id])

  @@index([pedidoId])
  @@map("movimientos_inventario")
}
