{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"]
  },
  // DECISIÓN DE PROTOTIPO: se fuerza polling porque el watch por eventos del
  // filesystem no llega de forma confiable a través del volumen bind-mount de
  // Docker Desktop en Windows; sin esto, `start:dev` no recompila solo al
  // guardar un archivo desde el host y hay que reiniciar el contenedor a mano.
  "watchOptions": {
    "watchFile": "fixedPollingInterval",
    "watchDirectory": "fixedPollingInterval",
    "fallbackPolling": "fixedInterval",
    // Sin esto, el polling también revisaba sin parar los miles de .d.ts de
    // node_modules: ~50 % de CPU en reposo por cada contenedor con --watch
    // (backend-1, backend-2 y worker), y la app se ponía lenta. Lo que se
    // edita es src/ y prisma/; un cambio de dependencias pide reiniciar igual.
    "excludeDirectories": ["**/node_modules", "dist", "dist-2", "dist-worker"],
    "excludeFiles": ["**/node_modules/**"]
  }
}
